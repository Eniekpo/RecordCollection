<div class="page-heading">
    <div>
        @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <div class="eyebrow">@Eyebrow</div> }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }
    </div>
    @if (Actions is not null) { <div class="page-heading-actions">@Actions</div> }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Eyebrow { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Actions { get; set; }
}
