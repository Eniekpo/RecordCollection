<div class="search-wrap">
    <span aria-hidden="true">⌕</span>
    <input class="form-control" value="@Value" @oninput="OnInput" placeholder="@Placeholder" aria-label="Search records" />
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search…";

    private Task OnInput(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
